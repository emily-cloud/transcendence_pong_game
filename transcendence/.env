# Transcendence Environment Configuration

# ================================
# Network & URLs
# ================================
NODE_ENV=development

# ================================
# PUBLIC URLs (Browser/External Access)
# ================================
# These URLs are accessed from browsers and external clients via nginx proxy
# nginx handles SSL termination and routes to internal services
VITE_API_BASE=/api
VITE_GATEWAY_BASE=/api
VITE_WS_BASE=/ws
FRONT_END_URL=https://localhost:8443

# ================================
# INTERNAL URLs (Docker Network)
# ================================
# These URLs are used for service-to-service communication within Docker network
# Services communicate directly without going through nginx
USER_SERVICE_URL=http://user-service:3001
GAME_SERVICE_URL=http://game-service:3002
LOG_SERVICE_URL=http://log-service:3003
TOURNAMENT_SERVICE_URL=http://tournament-service:3005
TOURNAMENT_SERVICE_INTERNAL_URL=http://tournament-service:3005
TESTDB_URL=http://testdb:3010
GATEWAY_URL=http://gateway:3000

# ================================
# Ports
# ================================
GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
GAME_SERVICE_PORT=3002
LOG_SERVICE_PORT=3003
FRONTEND_PORT=3004
TOURNAMENT_SERVICE_PORT=3005
TESTDB_PORT=3010

# Service Hosts (for external access via nginx proxy)
GAME_SERVICE_HOST=localhost
USER_SERVICE_HOST=localhost
LOG_SERVICE_HOST=localhost
# Public endpoints via nginx (HTTPS)
PUBLIC_API_BASE=https://localhost:8443/api
PUBLIC_WS_BASE=wss://localhost:8443/ws

# ================================
# Database
# ================================
# Main application database URL (SQLite format: sqlite:/path/to/db)
DATABASE_URL=sqlite:/app/shared/database/transcendence.db

# ================================
# Security
# ================================
JWT_SECRET=your-secret-key-change-in-production

# ================================
# Monitoring & Logging
# ================================
# Internal monitoring URLs (Docker network)
LOGSTASH_URL=http://logstash:5000
ELASTICSEARCH_URL=http://elasticsearch:9200
# External monitoring access (via nginx if configured)
KIBANA_URL=http://localhost:5601
KIBANA_ENCRYPTION_KEY=PLLT0Bh1PHaAAxHcuyGwD7HnjjTd3Pa4
KIBANA_REPORTING_KEY=0VKTuVBjR4AS5QwkYFJU2KzHG9kNUOCY
KIBANA_SECURITY_KEY=TDOyGqZizzpPwO2KfG5ACDdEEmsaaPIV

# ================================
# Development Settings
# ================================
# Set to true for debug logging
DEBUG=false

# Set to true to enable CORS for all origins (dev only)
CORS_ALLOW_ALL=true

# ================================
# Timeouts & Performance
# ================================
# HTTP request timeout for logger services (milliseconds)
LOG_REQUEST_TIMEOUT=1000

# Log service timeout (milliseconds)
LOG_SERVICE_TIMEOUT=2000

# Proxy request timeout (milliseconds)
PROXY_REQUEST_TIMEOUT=5000

# Maximum timeout for proxy requests with dynamic adjustment (milliseconds)
PROXY_MAX_TIMEOUT=15000

# Cookie max age (seconds)
COOKIE_MAX_AGE=3600

# ================================
# Database Queue Management
# ================================
# Database queue timeout - how long to wait for queue processing (milliseconds)
DB_QUEUE_TIMEOUT=8000

# Maximum number of items allowed in database queue
DB_QUEUE_MAX_SIZE=100

# Enable database service URL for gateway queue status checks
DATABASE_SERVICE_URL=http://database-service:3006

# ================================
# Gateway Queue Features
# ================================
# Enable gateway queue status checking before proxy requests
GATEWAY_QUEUE_CHECK_ENABLED=true

# Enable dynamic timeout adjustment based on queue status
GATEWAY_DYNAMIC_TIMEOUT=true

# ================================
# Database & Testing  
# ================================
# Test database service HTTP URL
TESTDB_URL=http://testdb:3010

# Test database SQLite file path (used by testdb-service)
TESTDB_DATABASE_PATH=/shared/test-db/pong.sqlite

# Database busy timeout - how long to wait for database locks (milliseconds)
DATABASE_BUSY_TIMEOUT=5000


# ================================
# ELK Stack Settings
# ================================
ES_JAVA_OPTS=-Xms512m -Xmx512m
LS_JAVA_OPTS=-Xms256m -Xmx256m

#

# ===============================
DB_INTERNAL_AUTH=super_secret_internal_token
# ================================